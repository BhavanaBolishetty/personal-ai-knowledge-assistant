# =============================================================================
# LOCAL DEVELOPMENT
# Everything below works out of the box for `docker compose up` or running
# the backend directly on your machine. Nothing in this section is needed
# in production — see the PRODUCTION section near the bottom instead.
# =============================================================================

# --- PostgreSQL ---
# POSTGRES_HOST=localhost is correct when running the backend directly on your
# machine (outside Docker). docker-compose.yml overrides this to "db" for the
# backend container automatically, so you do not need to change it for Docker use.
POSTGRES_USER=paika_user
POSTGRES_PASSWORD=paika_password
POSTGRES_DB=paika_knowledge_base
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Backend ---
BACKEND_PORT=8000
# Where uploaded files are saved, relative to the backend's working directory.
# Only used when STORAGE_BACKEND=local (the default — see PRODUCTION below).
STORAGE_DIR=storage/uploads
# Maximum accepted upload size, in bytes. Default: 10 MB.
MAX_UPLOAD_SIZE_BYTES=10485760

# --- URL ingestion (SSRF-conscious, see app/ingestion/url_fetcher.py) ---
URL_FETCH_TIMEOUT_SECONDS=10
MAX_URL_RESPONSE_BYTES=5242880
MAX_URL_REDIRECTS=5

# --- Chunking (see backend/app/core/config.py for reasoning) ---
CHUNK_SIZE_CHARS=1000
CHUNK_OVERLAP_CHARS=150

# --- Embeddings (see backend/app/core/config.py for reasoning) ---
# "local" = free, local sentence-transformers model, no API key needed —
# good for local dev, but loads torch (~370MB resident memory), which
# doesn't fit Render's free-tier 512MB backend. "gemini" = Gemini's remote
# embedding API (no local model/torch) — see PRODUCTION below.
EMBEDDING_PROVIDER=local
# Deliberately separate env var names per provider (not a shared
# EMBEDDING_MODEL_NAME/EMBEDDING_DIMENSION) — see the comment on
# _resolve_embedding_config in config.py for why a shared name is unsafe.
# Leave both unset to use the correct default for whichever
# EMBEDDING_PROVIDER is set; only override if you need a specific
# model/dimension. LOCAL_* only applies when EMBEDDING_PROVIDER=local;
# GEMINI_EMBEDDING_MODEL_NAME/GEMINI_EMBEDDING_DIMENSION (PRODUCTION
# section below) only apply when EMBEDDING_PROVIDER=gemini.
LOCAL_EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
LOCAL_EMBEDDING_DIMENSION=384
EMBEDDING_BATCH_SIZE=32

# --- Retrieval (see backend/app/core/config.py for reasoning) ---
DEFAULT_TOP_K=5
MAX_TOP_K=20
MAX_QUERY_LENGTH_CHARS=1000
# Minimum cosine-similarity score (0-1) a chunk must clear to be treated
# as relevant, even if it's among the top-K nearest neighbors.
MIN_RELEVANCE_SCORE=0.3

# --- Gemini / answer generation (see backend/app/core/config.py) ---
# Get a free API key at https://aistudio.google.com/apikey — never commit
# a real key. This repo's .gitignore already excludes .env.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
MAX_CONTEXT_CHARS=8000
# How many recent messages (user+assistant) are used for follow-up query
# condensing and shown to Gemini as conversation context.
CONVERSATION_HISTORY_LIMIT=6

# --- Frontend ---
# Base URL the frontend uses to reach the backend API.
VITE_API_BASE_URL=http://localhost:8000

# =============================================================================
# PRODUCTION
# Set these in the hosting provider's dashboard (Render, etc.) as real
# secrets — never in a committed file. Placeholders only below.
# =============================================================================

# Enables production behavior in backend/Dockerfile's start command
# (drops uvicorn --reload) and app/main.py. Leave unset locally.
ENVIRONMENT=production

# Comma-separated list of origins allowed to call the API with credentials.
# Set to the deployed frontend's exact origin — never "*".
ALLOWED_ORIGINS=https://your-frontend.onrender.com

# --- Database (Neon) ---
# Full connection string from the Neon dashboard. Overrides all of the
# local POSTGRES_* variables above when set. sslmode=require is added
# automatically if the string doesn't already specify one.
DATABASE_URL=postgresql://user:password@your-project.neon.tech/dbname

# --- File storage (Cloudflare R2) ---
# "local" (the default, used above) saves files to disk — fine for local
# dev, unsuitable in production since Render's filesystem is ephemeral.
# "r2" switches to Cloudflare R2 object storage; requires the four
# variables below.
STORAGE_BACKEND=r2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# --- Gemini ---
# Same variable as local dev (see above) — set as a real secret in Render,
# not committed here. Also used for embeddings when EMBEDDING_PROVIDER=gemini
# below — one key, no separate credential needed.
GEMINI_API_KEY=

# --- Embeddings (production) ---
# Switches off the local sentence-transformers/torch model (see LOCAL
# DEVELOPMENT above) in favor of Gemini's remote embedding API
# (gemini-embedding-001) — removes the ~370MB local-model memory footprint
# that doesn't fit Render's free-tier 512MB backend. After changing this on
# an already-deployed backend with existing documents, run
# `python -m scripts.backfill_embeddings` (see backend/scripts/) once,
# pointed at the same DATABASE_URL, to re-embed existing chunks — the
# Alembic migration that widens chunks.embedding for the new dimension
# clears old embeddings rather than leaving invalid ones in place.
EMBEDDING_PROVIDER=gemini
# Optional overrides — leave unset to use the verified defaults
# (gemini-embedding-001, 768 dimensions). Only applies when
# EMBEDDING_PROVIDER=gemini; has no effect on local dev's
# LOCAL_EMBEDDING_MODEL_NAME/LOCAL_EMBEDDING_DIMENSION above.
GEMINI_EMBEDDING_MODEL_NAME=gemini-embedding-001
GEMINI_EMBEDDING_DIMENSION=768
# Also controls the Dockerfile build: skips installing
# sentence-transformers/torch entirely when set to "false" (smaller image,
# faster build — the app never imports them when EMBEDDING_PROVIDER=gemini).
INSTALL_LOCAL_EMBEDDINGS=false
